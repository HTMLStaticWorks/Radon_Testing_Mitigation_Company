<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 600" width="900" height="600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#101719"/>
      <stop offset="50%" stop-color="#17252B"/>
      <stop offset="100%" stop-color="#1E3040"/>
    </linearGradient>
    <linearGradient id="buildingGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1A3040"/>
      <stop offset="100%" stop-color="#0E1F28"/>
    </linearGradient>
  </defs>
  <rect width="900" height="600" fill="url(#bg)"/>

  <!-- Technical grid overlay -->
  <g stroke="#1E3040" stroke-width="1" opacity="0.5">
    <line x1="0" y1="100" x2="900" y2="100"/>
    <line x1="0" y1="200" x2="900" y2="200"/>
    <line x1="0" y1="300" x2="900" y2="300"/>
    <line x1="0" y1="400" x2="900" y2="400"/>
    <line x1="0" y1="500" x2="900" y2="500"/>
    <line x1="100" y1="0" x2="100" y2="600"/>
    <line x1="200" y1="0" x2="200" y2="600"/>
    <line x1="300" y1="0" x2="300" y2="600"/>
    <line x1="400" y1="0" x2="400" y2="600"/>
    <line x1="500" y1="0" x2="500" y2="600"/>
    <line x1="600" y1="0" x2="600" y2="600"/>
    <line x1="700" y1="0" x2="700" y2="600"/>
    <line x1="800" y1="0" x2="800" y2="600"/>
  </g>

  <!-- BUILDING CROSS SECTION - BUILDING SCIENCE DIAGRAM -->
  <!-- Soil -->
  <rect x="50" y="450" width="800" height="120" fill="#0A1420" rx="4"/>
  <text x="450" y="510" fill="#2D4F60" font-family="monospace" font-size="16" text-anchor="middle" font-weight="bold">SUBSURFACE · SOIL GAS MIGRATION ZONE</text>

  <!-- Foundation -->
  <rect x="100" y="415" width="700" height="38" fill="#1A3040"/>
  <text x="450" y="440" fill="#647C82" font-family="monospace" font-size="11" text-anchor="middle">POURED CONCRETE FOUNDATION SLAB</text>

  <!-- Building shell -->
  <rect x="100" y="80" width="20" height="338" fill="url(#buildingGrad)"/>
  <rect x="780" y="80" width="20" height="338" fill="url(#buildingGrad)"/>

  <!-- Building interior area -->
  <rect x="120" y="80" width="660" height="338" fill="#0F1E28" opacity="0.85"/>

  <!-- Roof -->
  <rect x="85" y="65" width="730" height="18" fill="#0E1F28"/>
  <rect x="85" y="65" width="730" height="4" fill="#397A78" opacity="0.7"/>

  <!-- Floor 1 -->
  <rect x="120" y="295" width="660" height="10" fill="#1A3040"/>

  <!-- Windows level 2 -->
  <rect x="145" y="100" width="120" height="80" fill="#0A1820" stroke="#2D414B" stroke-width="1.5" rx="2"/>
  <rect x="145" y="100" width="120" height="80" fill="#D5A548" opacity="0.1"/>
  <rect x="300" y="100" width="120" height="80" fill="#0A1820" stroke="#2D414B" stroke-width="1.5" rx="2"/>
  <rect x="300" y="100" width="120" height="80" fill="#D5A548" opacity="0.08"/>
  <rect x="480" y="100" width="120" height="80" fill="#0A1820" stroke="#2D414B" stroke-width="1.5" rx="2"/>
  <rect x="480" y="100" width="120" height="80" fill="#D5A548" opacity="0.12"/>
  <rect x="635" y="100" width="120" height="80" fill="#0A1820" stroke="#2D414B" stroke-width="1.5" rx="2"/>
  <rect x="635" y="100" width="120" height="80" fill="#D5A548" opacity="0.08"/>

  <!-- Windows level 1 -->
  <rect x="145" y="320" width="160" height="75" fill="#0A1820" stroke="#2D414B" stroke-width="1.5" rx="2"/>
  <rect x="145" y="320" width="160" height="75" fill="#D5A548" opacity="0.1"/>
  <rect x="595" y="320" width="160" height="75" fill="#0A1820" stroke="#2D414B" stroke-width="1.5" rx="2"/>
  <rect x="595" y="320" width="160" height="75" fill="#D5A548" opacity="0.1"/>

  <!-- Central door -->
  <rect x="390" y="340" width="120" height="75" fill="#0A1820" stroke="#397A78" stroke-width="2" rx="3"/>
  <circle cx="413" cy="380" r="5" fill="#D5A548" opacity="0.7"/>

  <!-- MEASUREMENT ANNOTATION LINES -->
  <!-- Building height annotation -->
  <line x1="820" y1="65" x2="820" y2="415" stroke="#397A78" stroke-width="1.5" stroke-dasharray="6,4"/>
  <line x1="814" y1="65" x2="826" y2="65" stroke="#397A78" stroke-width="2"/>
  <line x1="814" y1="415" x2="826" y2="415" stroke="#397A78" stroke-width="2"/>
  <text x="855" y="245" fill="#397A78" font-family="monospace" font-size="11" text-anchor="middle" font-weight="bold">BLDG</text>
  <text x="855" y="260" fill="#397A78" font-family="monospace" font-size="11" text-anchor="middle" font-weight="bold">ENV.</text>

  <!-- Pressure annotation -->
  <text x="450" y="195" fill="#D5A548" font-family="monospace" font-size="12" text-anchor="middle" opacity="0.6">INDOOR PRESSURE ZONE</text>

  <!-- Sub-slab airflow arrows going up into building -->
  <g fill="#4D9694" opacity="0.55">
    <polygon points="200,450 194,465 206,465"/>
    <polygon points="310,450 304,465 316,465"/>
    <polygon points="450,450 444,465 456,465"/>
    <polygon points="590,450 584,465 596,465"/>
    <polygon points="700,450 694,465 706,465"/>
  </g>

  <!-- Crack / pathway indicators in slab -->
  <path d="M 190 415 Q 205 418 215 415" stroke="#D5A548" stroke-width="1.5" fill="none" stroke-opacity="0.5"/>
  <path d="M 440 415 Q 455 419 465 415" stroke="#D5A548" stroke-width="1.5" fill="none" stroke-opacity="0.5"/>
  <path d="M 690 415 Q 702 419 715 415" stroke="#D5A548" stroke-width="1.5" fill="none" stroke-opacity="0.5"/>

  <!-- Building science labels -->
  <rect x="120" y="233" width="180" height="28" fill="#397A78" opacity="0.15" rx="4" stroke="#397A78" stroke-width="1"/>
  <text x="210" y="252" fill="#4D9694" font-family="monospace" font-size="10" text-anchor="middle">STACK EFFECT PRESSURE</text>

  <rect x="600" y="233" width="180" height="28" fill="#D5A548" opacity="0.1" rx="4" stroke="#D5A548" stroke-width="1"/>
  <text x="690" y="252" fill="#D5A548" font-family="monospace" font-size="10" text-anchor="middle">THERMAL BUOYANCY</text>

  <text x="450" y="580" fill="#FFFFFF" fill-opacity="0.12" font-family="sans-serif" font-size="10" text-anchor="middle" letter-spacing="3">RADENZA • BUILDING SCIENCE &amp; ENVELOPE ANALYSIS</text>
</svg>
