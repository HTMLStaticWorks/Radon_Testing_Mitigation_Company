<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 600" width="900" height="600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0A1820"/>
      <stop offset="50%" stop-color="#17252B"/>
      <stop offset="100%" stop-color="#1A3040"/>
    </linearGradient>
    <linearGradient id="screenGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#0F1E28"/>
      <stop offset="100%" stop-color="#0A1420"/>
    </linearGradient>
  </defs>
  <rect width="900" height="600" fill="url(#bg)"/>
  <!-- Grid -->
  <g stroke="#1E3040" stroke-width="0.5" opacity="0.4">
    <line x1="0" y1="150" x2="900" y2="150"/>
    <line x1="0" y1="300" x2="900" y2="300"/>
    <line x1="0" y1="450" x2="900" y2="450"/>
    <line x1="225" y1="0" x2="225" y2="600"/>
    <line x1="450" y1="0" x2="450" y2="600"/>
    <line x1="675" y1="0" x2="675" y2="600"/>
  </g>

  <!-- Two device comparison -->
  <!-- BEFORE Device -->
  <rect x="100" y="140" width="280" height="330" fill="#1E2E38" rx="16" stroke="#2D414B" stroke-width="2"/>
  <text x="240" y="110" fill="#647C82" font-family="monospace" font-size="13" text-anchor="middle" font-weight="bold">INITIAL TEST</text>
  <rect x="115" y="155" width="250" height="200" fill="url(#screenGrad)" rx="10"/>
  <rect x="115" y="155" width="250" height="5" fill="#397A78" opacity="0.8" rx="3"/>
  <circle cx="240" cy="245" r="70" fill="none" stroke="#2D414B" stroke-width="8"/>
  <circle cx="240" cy="245" r="70" fill="none" stroke="#397A78" stroke-width="5" stroke-dasharray="160,280" stroke-linecap="round" transform="rotate(-90 240 245)"/>
  <text x="240" y="238" fill="#FFFFFF" font-family="monospace" font-size="12" text-anchor="middle">BASELINE</text>
  <text x="240" y="256" fill="#94A6AE" font-family="monospace" font-size="11" text-anchor="middle">TEST RESULT</text>
  <!-- Bottom row -->
  <rect x="120" y="368" width="76" height="42" fill="#0F1E28" rx="6"/>
  <text x="158" y="384" fill="#94A6AE" font-family="monospace" font-size="8" text-anchor="middle">STATUS</text>
  <text x="158" y="399" fill="#FFFFFF" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">COMPLETE</text>
  <rect x="204" y="368" width="86" height="42" fill="#0F1E28" rx="6"/>
  <text x="247" y="384" fill="#94A6AE" font-family="monospace" font-size="8" text-anchor="middle">METHOD</text>
  <text x="247" y="399" fill="#FFFFFF" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">48-HR CRM</text>
  <rect x="298" y="368" width="72" height="42" fill="#0F1E28" rx="6"/>
  <text x="334" y="384" fill="#94A6AE" font-family="monospace" font-size="8" text-anchor="middle">LABEL</text>
  <text x="334" y="399" fill="#D5A548" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">BASELINE</text>
  <!-- Status stand -->
  <rect x="195" y="470" width="90" height="10" fill="#17252B" rx="3"/>

  <!-- Arrow between devices -->
  <text x="450" y="290" fill="#397A78" font-family="monospace" font-size="40" text-anchor="middle">→</text>
  <text x="450" y="320" fill="#647C82" font-family="monospace" font-size="10" text-anchor="middle">MITIGATION</text>

  <!-- AFTER Device -->
  <rect x="520" y="140" width="280" height="330" fill="#1E2E38" rx="16" stroke="#397A78" stroke-width="2.5"/>
  <text x="660" y="110" fill="#4D9694" font-family="monospace" font-size="13" text-anchor="middle" font-weight="bold">FOLLOW-UP TEST</text>
  <rect x="535" y="155" width="250" height="200" fill="url(#screenGrad)" rx="10"/>
  <rect x="535" y="155" width="250" height="5" fill="#D5A548" opacity="0.8" rx="3"/>
  <circle cx="660" cy="245" r="70" fill="none" stroke="#2D414B" stroke-width="8"/>
  <circle cx="660" cy="245" r="70" fill="none" stroke="#4D9694" stroke-width="5" stroke-dasharray="60,380" stroke-linecap="round" transform="rotate(-90 660 245)"/>
  <text x="660" y="238" fill="#FFFFFF" font-family="monospace" font-size="12" text-anchor="middle">FOLLOW-UP</text>
  <text x="660" y="256" fill="#4D9694" font-family="monospace" font-size="11" text-anchor="middle">VERIFIED</text>
  <!-- Bottom row -->
  <rect x="540" y="368" width="76" height="42" fill="#0F1E28" rx="6"/>
  <text x="578" y="384" fill="#94A6AE" font-family="monospace" font-size="8" text-anchor="middle">STATUS</text>
  <text x="578" y="399" fill="#4D9694" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">VERIFIED</text>
  <rect x="624" y="368" width="86" height="42" fill="#0F1E28" rx="6"/>
  <text x="667" y="384" fill="#94A6AE" font-family="monospace" font-size="8" text-anchor="middle">METHOD</text>
  <text x="667" y="399" fill="#FFFFFF" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">POST-MIT</text>
  <rect x="718" y="368" width="72" height="42" fill="#D5A548" opacity="0.2" rx="6" stroke="#D5A548" stroke-width="1"/>
  <text x="754" y="384" fill="#D5A548" font-family="monospace" font-size="8" text-anchor="middle">RESULT</text>
  <text x="754" y="399" fill="#D5A548" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">LOGGED</text>
  <rect x="615" y="470" width="90" height="10" fill="#17252B" rx="3"/>

  <text x="450" y="560" fill="#FFFFFF" fill-opacity="0.12" font-family="sans-serif" font-size="10" text-anchor="middle" letter-spacing="3">RADENZA • POST-MITIGATION RE-TESTING VERIFICATION</text>
</svg>
